+def edge_length(points, edges):
+    """Total length of a graph: the sum of its edge lengths."""
+    if len(edges) == 0:
+        return 0.0
+    edges = np.asarray(edges, np.int64)
+    return float(np.linalg.norm(points[edges[:, 0]] - points[edges[:, 1]], axis=1).sum())
+
+
+def realised_length(points, edges, new_points, new_edges):
+    """Length an error added or removed, read off the edges that changed.
+
+    Counting the moved chunk while it is built misses the boundary edges that
+    join it to the rest of the graph (they are deleted or added too), and
+    summing a component's nodes in index order measures distances between
+    nodes that are not joined at all. The difference of the two totals is
+    exact for every error that only adds or removes edges. Rounded to 1e-6 mm
+    so that errors of equal length, e.g. two 5 mm false branches, stay tied in
+    a rank correlation instead of being ordered by floating-point noise.
+    """
+    return round(abs(edge_length(new_points, new_edges)
+                     - edge_length(points, edges)), 6)
+
+
+def betti(n_nodes, edges):
+    """(b0, b1) of a graph: connected components and independent cycles."""
+    e = (np.sort(np.asarray(edges, np.int64), axis=1) if len(edges)
+         else np.zeros((0, 2), np.int64))
+    e = e[e[:, 0] != e[:, 1]]
+    e = np.unique(e, axis=0) if len(e) else e
+    parent = np.arange(n_nodes)
+
+    def find(x):
+        while parent[x] != x:
+            parent[x] = parent[parent[x]]
+            x = parent[x]
+        return x
+
+    for u, v in e:
+        ru, rv = find(u), find(v)
+        if ru != rv:
+            parent[ru] = rv
+    b0 = len({find(i) for i in range(n_nodes)}) if n_nodes else 0
+    return b0, int(len(e) - n_nodes + b0)
+
+
+def arc_lengths(points, path):
+    """Cumulative arc length along a node path, starting at 0."""
+    return np.concatenate([[0.0], np.cumsum(np.linalg.norm(
+        np.diff(points[np.asarray(path)], axis=0), axis=1))])
+
