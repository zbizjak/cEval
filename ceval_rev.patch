+"""Response, within-case ordering and cross-case separation, kept apart.
+
+The sensitivity score S folds two different properties into one number: the
+Spearman rho of the shift against the realised error size, pooled over all
+cases, and the median Cohen's d between adjacent severity groups, which
+compares cases with each other. A metric can order the severities perfectly
+within every case and still separate them poorly across cases, when the size
+of its response varies more between patients than between steps. Per
+(dataset, error, metric) this reports:
+
+  response      share of rows with a non-zero shift
+  ordering      within-case concordance: for every pair of severity steps of
+                one case with different realised size, 1 if the larger error
+                has the larger shift, 0.5 for a tie, 0 otherwise; averaged
+                within each case first, then over cases
+  rho, d        the two ingredients of S (d uncapped, same-constant
+                transitions as 0)
+
+    python3 step5_robustness/ordering.py   # -> results/robustness/ordering.json
+"""
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from config import REPO, RESULTS, FIGURES, TABLES, DATA, VOLUME2GRAPH  # noqa: E402,F401
+
+import scoring as sc  # noqa: E402
+
+OUT = RESULTS / "robustness"
+
+
+def within_case_ordering(d, m):
+    y_all, x_all, cases = d["shift"][m], d["mag"], d["case_i"]
+    per_case = []
+    for c in np.unique(cases):
+        i = np.flatnonzero((cases == c) & ~np.isnan(y_all))
+        if len(i) < 2:
+            continue
+        x, y = x_all[i], y_all[i]
+        dx = np.sign(x[:, None] - x[None, :])
+        dy = np.sign(y[:, None] - y[None, :])
+        iu = np.triu_indices(len(i), 1)
+        dx, dy = dx[iu], dy[iu]
+        keep = dx != 0
+        if not keep.any():
+            continue
+        conc = np.where(dy[keep] == 0, 0.5, (dx[keep] == dy[keep]).astype(float))
+        per_case.append(conc.mean())
+    return (float(np.mean(per_case)), len(per_case)) if per_case else (None, 0)
+
+
+def main():
+    arrays = sc.load_all()
+    out = {}
+    for ds, arr in arrays.items():
+        res = sc.score_dataset(arr, np.arange(len(arr.cases)), caps=(np.inf,))
+        out[ds] = {}
+        for e in arr.errors:
+            d = arr.err[e]
+            out[ds][e] = {}
+            for m in arr.metrics:
+                y = d["shift"][m]
+                ok = ~np.isnan(y)
+                c = res[e]["cells"][m]
+                ordering, n_cases = within_case_ordering(d, m)
+                out[ds][e][m] = {"response": float((np.abs(y[ok]) > 1e-9).mean()) if ok.any() else None,
+                                 "ordering": ordering, "n_cases": n_cases, "rho": c["rho"],
+                                 "d": c["d"].get(("zero", np.inf)), "status": c["status"]}
+    (OUT / "ordering.json").write_text(json.dumps(out, indent=1))
+    print("bifurcation shift: response / within-case ordering / rho / d")
+    for ds in out:
+        for m in ("ASCD", "netmets_geom_F1", "branch_coverage_F1", "junction_F1", "APLS", "HD95", "endpoint_F1"):
+            r = out[ds]["bifurcation_shift"][m]
+            f = lambda v: "  -  " if v is None else f"{v:5.3f}"
+            print(f"  {ds:11s} {m:20s} {f(r['response'])} {f(r['ordering'])} {f(r['rho'])} {f(r['d'])}")
+    print(f"-> {(OUT / 'ordering.json').relative_to(REPO)}")
+
+
+if __name__ == "__main__":
+    main()
