+++ ceval_rev/janniks/step5_robustness/selection.py	2026-10-15 12:24:24.293992682 +0200
@@ -0,0 +1,260 @@
+"""How the selected metric set depends on how the score is built.
+
+The paper's set was chosen by greedy set cover on one score matrix: cap 4 on
+Cohen's d, circular pairs excluded. This repeats the selection on the full
+data under every combination of
+
+  cap        4, 2, 1      (S = max(0, rho) * min(1, d / cap))
+  exclusion  none         every pair counts
+             cv           the zero-spread test of the first version
+             analytical   make_tables.CIRCULAR_PAIRS (the paper's policy)
+
+and reports, for each: the greedy order, the exhaustive best triplet over all
+969, the coverage of the published triplet and of its ASCD / HD95 variants,
+the weakest error, leave-one-dataset-out and leave-one-family-out transfer,
+and equal weighting of the three error families. Exclusions mask the score
+matrix, never the targets. Targets are the (dataset, error) pairs where the
+error is injected and forms a severity ladder; the others are listed, not
+scored as zero.
+
+Coverage comes in two forms:
+  policy-consistent  on the masked matrix, relative to the best any of the
+                     nineteen metrics reaches under the same mask
+  unmasked           on the raw matrix, relative to the raw ceiling
+
+    python3 step5_robustness/selection.py   # -> results/robustness/selection.json
+"""
+import itertools
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from config import REPO, RESULTS, FIGURES, TABLES, DATA, VOLUME2GRAPH  # noqa: E402,F401
+
+import scoring as sc  # noqa: E402
+from scoring import mt  # noqa: E402
+from perturb import PERTURBATIONS  # noqa: E402
+
+OUT = RESULTS / "robustness"
+OUT.mkdir(parents=True, exist_ok=True)
+
+M = sc.METRICS
+MI = {m: i for i, m in enumerate(M)}
+CAPS = (4.0, 2.0, 1.0)
+POLICIES = ("none", "cv", "analytical")
+COMBOS3 = np.array(list(itertools.combinations(range(len(M)), 3)))
+PUBLISHED = ("Len_tot", "endpoint_F1", "netmets_geom_F1")
+VARIANTS_OF_PUBLISHED = {"ASCD": ("ASCD", "Len_tot", "endpoint_F1"),
+                         "HD95": ("HD95", "Len_tot", "endpoint_F1")}
+FAMILY = {e: PERTURBATIONS[e]["group"] for e in sc.ERRORS}
+
+
+def idx_of(names):
+    return [MI[n] for n in names]
+
+
+def build(results, cap, zero_policy="zero"):
+    """Eligible targets, ineligible targets, score matrix (metrics x targets)
+    and the CV flag, from score_dataset output for every dataset."""
+    targets, inel = [], []
+    for ds in sc.DATASETS:
+        for e in sc.ERRORS:
+            if ds in results and e in results[ds]:
+                (targets if results[ds][e]["ladder"] else inel).append((ds, e))
+    S = np.zeros((len(M), len(targets)))
+    cv = np.zeros((len(M), len(targets)), bool)
+    for j, (ds, e) in enumerate(targets):
+        for m in M:
+            c = results[ds][e]["cells"][m]
+            cv[MI[m], j] = c["cv_flag"]
+            v = c["score"].get((zero_policy, cap))
+            S[MI[m], j] = v if v is not None else 0.0
+    return targets, inel, S, cv
+
+
+def masks(targets, cv):
+    an = np.zeros((len(M), len(targets)), bool)
+    for j, (_, e) in enumerate(targets):
+        for m, e2 in mt.CIRCULAR_PAIRS:
+            if e2 == e:
+                an[MI[m], j] = True
+    return {"none": np.zeros_like(cv), "cv": cv, "analytical": an}
+
+
+def cov(S, idx, w):
+    return float((S[list(idx)].max(axis=0) * w).sum())
+
+
+def greedy(S, w, n_steps=6, min_gain=0.05):
+    """make_tables.pooled_greedy on a matrix; ties go to the first metric in
+    ALL_METRICS order."""
+    covered, picks = np.zeros(S.shape[1]), []
+    for _ in range(n_steps):
+        gains = ((np.maximum(covered, S) - covered) * w).sum(axis=1)
+        gains[picks] = -1.0
+        k = int(np.argmax(gains))
+        if gains[k] < min_gain:
+            break
+        picks.append(k)
+        covered = np.maximum(covered, S[k])
+    return picks
+
+
+def exhaustive3(S, w, top=10):
+    c = (S[COMBOS3].max(axis=1) * w).sum(axis=1)
+    order = np.argsort(-c, kind="stable")
+    return [(tuple(sorted(M[i] for i in COMBOS3[k])), float(c[k])) for k in order[:top]]
+
+
+def summarize(S_raw, mask, w=None):
+    w = np.ones(S_raw.shape[1]) if w is None else w
+    S_m = np.where(mask, 0.0, S_raw)
+    ceil_m, ceil_u = float((S_m.max(0) * w).sum()), float((S_raw.max(0) * w).sum())
+    g = greedy(S_m, w)
+    ex = exhaustive3(S_m, w)
+    sets = {"published": idx_of(PUBLISHED), "greedy3": g[:3], "exhaustive": idx_of(ex[0][0]),
+            **{f"published_{k}": idx_of(v) for k, v in VARIANTS_OF_PUBLISHED.items()}}
+    return {"greedy_picks": [M[i] for i in g],
+            "greedy_gains": [cov(S_m, g[:i + 1], w) - cov(S_m, g[:i], w) if i else cov(S_m, g[:1], w)
+                             for i in range(len(g))],
+            "exhaustive_top10": ex, "ceiling_masked": ceil_m, "ceiling_unmasked": ceil_u,
+            "coverage": {name: {"metrics": [M[i] for i in ix],
+                                "policy_consistent_abs": cov(S_m, ix, w),
+                                "policy_consistent_rel": cov(S_m, ix, w) / ceil_m if ceil_m else None,
+                                "unmasked_abs": cov(S_raw, ix, w),
+                                "unmasked_rel": cov(S_raw, ix, w) / ceil_u if ceil_u else None}
+                         for name, ix in sets.items()}}
+
+
+def per_dataset_coverage(targets, S_m, names):
+    """Coverage of a fixed set on each dataset, relative to all nineteen."""
+    out = {}
+    for ds in sc.DATASETS:
+        cols = [j for j, t in enumerate(targets) if t[0] == ds]
+        if cols:
+            ceil = float(S_m[:, cols].max(0).sum())
+            out[ds] = float(S_m[idx_of(names)][:, cols].max(0).sum()) / ceil if ceil else None
+    return out
+
+
+def weakest_error(targets, S_m):
+    best = S_m.max(0)
+    by_err = {}
+    for j, (ds, e) in enumerate(targets):
+        by_err.setdefault(e, {})[ds] = float(best[j])
+    mean_best = {e: float(np.mean(list(v.values()))) for e, v in by_err.items()}
+    return {"mean_best_S": dict(sorted(mean_best.items(), key=lambda kv: kv[1])),
+            "best_S_by_dataset": by_err,
+            "mean_best_S_by_dataset": {ds: float(np.mean([best[j] for j, t in enumerate(targets) if t[0] == ds]))
+                                       for ds in sc.DATASETS if any(t[0] == ds for t in targets)}}
+
+
+def holdouts(targets, S_m):
+    folds = {f"dataset:{ds}": [j for j, t in enumerate(targets) if t[0] == ds] for ds in sc.DATASETS}
+    folds["dataset:topcow_mr+topcow_ct"] = [j for j, t in enumerate(targets)
+                                            if t[0] in ("topcow_mr", "topcow_ct")]
+    for fam in sorted(set(FAMILY.values())):
+        folds[f"family:{fam}"] = [j for j, t in enumerate(targets) if FAMILY[t[1]] == fam]
+    out = {}
+    for name, held in folds.items():
+        if not held:
+            continue
+        train = [j for j in range(len(targets)) if j not in set(held)]
+        St, Sh = S_m[:, train], S_m[:, held]
+        wt, wh = np.ones(len(train)), np.ones(len(held))
+        g3 = greedy(St, wt, n_steps=3, min_gain=0.0)
+        ex_train = exhaustive3(St, wt, top=1)[0][0]
+        ceil_set, ceil = exhaustive3(Sh, wh, top=1)[0]
+        out[name] = {"n_held_targets": len(held),
+                     "greedy_train_triplet": [M[i] for i in g3],
+                     "exhaustive_train_triplet": list(ex_train),
+                     "held_out_best_triplet": list(ceil_set), "held_out_ceiling": ceil,
+                     "transfer_greedy_rel": cov(Sh, g3, wh) / ceil if ceil else None,
+                     "transfer_exhaustive_rel": cov(Sh, idx_of(ex_train), wh) / ceil if ceil else None,
+                     "published_on_held_rel": cov(Sh, idx_of(PUBLISHED), wh) / ceil if ceil else None}
+    return out
+
+
+def equal_family_weights(targets):
+    fams = sorted({FAMILY[e] for _, e in targets})
+    n_f = {f: sum(1 for _, e in targets if FAMILY[e] == f) for f in fams}
+    # scaled to sum to the number of targets, so min_gain keeps its meaning
+    return np.array([len(targets) / (len(fams) * n_f[FAMILY[e]]) for _, e in targets]), n_f
+
+
+def zero_policy_changes(results, cap=4.0):
+    """Cells whose score moves when same-constant transitions count as d = 0."""
+    out = []
+    for ds, r in results.items():
+        for e, er in r.items():
+            if not er["ladder"]:
+                continue
+            for m in M:
+                c = er["cells"][m]
+                a = c["score"].get(("omit", cap)) or 0.0
+                b = c["score"].get(("zero", cap)) or 0.0
+                if abs(a - b) > 1e-12:
+                    out.append({"dataset": ds, "error": e, "metric": m, "omit": a, "zero": b})
+    return sorted(out, key=lambda x: x["zero"] - x["omit"])
+
+
+def main():
+    arrays = sc.load_all()
+    results = {ds: sc.score_dataset(a, np.arange(len(a.cases)), caps=CAPS, zero_policies=("zero", "omit"))
+               for ds, a in arrays.items()}
+    report = {"published_triplet": PUBLISHED, "circular_pairs": sorted(mt.CIRCULAR_PAIRS)}
+    changes = zero_policy_changes(results)
+    report["zero_policy_changes_cap4"] = changes
+    n_cells = sum(len(M) for r in results.values() for er in r.values() if er["ladder"])
+    print(f"same-constant transitions as d = 0: {len(changes)} of {n_cells} cells change at cap 4; "
+          f"selected sets below use d = 0")
+
+    report["settings"] = {}
+    for cap in CAPS:
+        targets, inel, S, cv = build(results, cap)
+        mk = masks(targets, cv)
+        key = f"cap{cap:g}"
+        rec = {"eligible_targets": targets, "ineligible_targets": inel,
+               "cv_not_analytical": sorted({(M[i], targets[j][1]) for i, j in zip(*np.nonzero(cv & ~mk["analytical"]))}),
+               "analytical_not_cv": sorted({(M[i], targets[j][1]) for i, j in zip(*np.nonzero(mk["analytical"] & ~cv))}),
+               "policies": {}}
+        wv, n_f = equal_family_weights(targets)
+        for pol in POLICIES:
+            S_m = np.where(mk[pol], 0.0, S)
+            s = summarize(S, mk[pol])
+            s["per_dataset_coverage"] = {
+                "published": per_dataset_coverage(targets, S_m, PUBLISHED),
+                "exhaustive": per_dataset_coverage(targets, S_m, s["exhaustive_top10"][0][0]),
+                "greedy3": per_dataset_coverage(targets, S_m, s["greedy_picks"][:3])}
+            s["weakest_error"] = weakest_error(targets, S_m)
+            s["holdouts"] = holdouts(targets, S_m)
+            s["equal_family"] = {"targets_per_family": n_f, **summarize(S, mk[pol], wv)}
+            rec["policies"][pol] = s
+        report["settings"][key] = rec
+
+    print(f"\n{'setting':8s} {'policy':11s} {'greedy (first 3)':48s} {'exhaustive best 3':48s} published")
+    for key, rec in report["settings"].items():
+        for pol, s in rec["policies"].items():
+            print(f"{key:8s} {pol:11s} {', '.join(s['greedy_picks'][:3]):48s} "
+                  f"{', '.join(s['exhaustive_top10'][0][0]):48s} "
+                  f"{s['coverage']['published']['policy_consistent_rel']:.3f}")
+    print("\nweakest errors (mean over datasets of the best score of any metric), analytical policy:")
+    for key, rec in report["settings"].items():
+        w = rec["policies"]["analytical"]["weakest_error"]
+        lo = list(w["mean_best_S"].items())[:3]
+        print(f"  {key:6s} " + ", ".join(f"{e} {v:.3f}" for e, v in lo)
+              + f" | bifurcation_shift on ImageCAS "
+                f"{w['best_S_by_dataset']['bifurcation_shift'].get('imagecas', float('nan')):.3f}")
+    print("\npairs the CV test flags that the analytical list does not:",
+          report["settings"]["cap4"]["cv_not_analytical"])
+    print("pairs the analytical list excludes that the CV test misses:",
+          report["settings"]["cap4"]["analytical_not_cv"])
+    (OUT / "selection.json").write_text(json.dumps(report, indent=1, default=str))
+    print(f"\n-> {(OUT / 'selection.json').relative_to(REPO)}")
+
+
+if __name__ == "__main__":
+    main()
diff -ruN '--exclude=results' '--exclude=figures' '--exclude=tables' '--exclude=__pycache__' '--exclude=*.pdf' '--exclude=examples' '--exclude=images_v5' ceval/janniks/step5_robustness/validation.py ceval_rev/janniks/step5_robustness/validation.py
