+def _deg2_runs(cyc, adj):
+    """Maximal runs of consecutive cycle nodes that have degree 2 and are
+    joined by an edge, walking the cycle in order (wrapping around)."""
+    n = len(cyc)
+    if n == 0:
+        return []
+    junction_pos = [i for i, c in enumerate(cyc) if len(adj[c]) != 2]
+    start = (junction_pos[0] + 1) % n if junction_pos else 0
+    order = [cyc[(start + i) % n] for i in range(n)]
+    runs, cur = [], []
+    for c in order:
+        if len(adj[c]) == 2 and (not cur or c in adj[cur[-1]]):
+            cur.append(c)
+        else:
+            if cur:
+                runs.append(cur)
+            cur = [c] if len(adj[c]) == 2 else []
+    if cur:
+        runs.append(cur)
+    return runs
 
 
