+        bs = b[f"paired|cap{cap}|{pol}"]
+        g = ", ".join(f"{SHORT[m]} (+{x:.2f})" for m, x in zip(p["greedy_picks"][:4], p["greedy_gains"][:4]))
+        best = p["exhaustive_top10"][0][0]
+        w = list(p["weakest_error"]["mean_best_S"].items())[:2]
