+++ ceval_rev/janniks/step5_robustness/validation.py	2026-10-15 13:30:24.092102084 +0200
@@ -0,0 +1,86 @@
+"""Do the perturbations do what they claim? Read off the sweep rows.
+
+Per (dataset, error): rows, rows that realised fewer errors than requested,
+the change in b0 and b1 against n_applied, and for bifurcation shift the
+landmark checks, the rejected operations and the realised arc against the
+request. Also the distinct realised sizes per case (the severity ladder).
+
+    python3 step5_robustness/validation.py   # -> results/robustness/perturbation_validation.json
+"""
+import json
+import sys
+from collections import Counter
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from config import REPO, RESULTS, FIGURES, TABLES, DATA, VOLUME2GRAPH  # noqa: E402,F401
+
+import make_tables as mt  # noqa: E402
+
+OUT = RESULTS / "robustness"
+OUT.mkdir(parents=True, exist_ok=True)
+# the Betti number each error is meant to move, and in which direction
+EXPECTED = {"disconnection": ("d_b0", 1), "false_component": ("d_b0", 1),
+            "false_loop": ("d_b1", 1), "cycle_disconnection": ("d_b1", -1)}
+
+
+def summarize(rows, err):
+    sub = [r for r in rows if r["error"] == err]
+    if not sub:
+        return None
+    out = {"rows": len(sub),
+           "fewer_than_requested": sum(r["n_applied"] < r["severity"] for r in sub
+                                       if float(r["severity"]).is_integer() and r["severity"] >= 1
+                                       and mt_kind(err) == "count")}
+    ch = [r.get("checks", {}) for r in sub]
+    out["d_b0"] = dict(sorted(Counter(c.get("d_b0") for c in ch).items(), key=str))
+    out["d_b1"] = dict(sorted(Counter(c.get("d_b1") for c in ch).items(), key=str))
+    if err in EXPECTED:
+        key, sign = EXPECTED[err]
+        out[f"{key}_equals_n_applied"] = float(np.mean([sign * c.get(key, 0) == r["n_applied"]
+                                                         for c, r in zip(ch, sub)]))
+    if err == "disconnection":
+        # a cut on a branch that lies on a cycle opens the cycle instead
+        out["cuts_opening_a_cycle"] = int(sum(-c.get("d_b1", 0) for c in ch))
+        out["cuts_total"] = int(sum(r["n_applied"] for r in sub))
+    if err == "bifurcation_shift":
+        out.update(landmarks_moved=sum(c.get("landmarks_moved", 0) for c in ch),
+                   endpoints_moved=sum(c.get("endpoints_moved", 0) for c in ch),
+                   new_coincident_pairs=sum(c.get("new_coincident_pairs", 0) for c in ch),
+                   betti_changed=sum(bool(c.get("d_b0") or c.get("d_b1")) for c in ch),
+                   rejected_operations=sum(r.get("n_rejected_ops", 0) for r in sub),
+                   max_arc_error_mm=max(r.get("max_arc_error_mm", 0.0) for r in sub),
+                   displacement_per_shift_mm=[float(np.percentile(
+                       [r["displacement_mm"] / r["n_applied"] for r in sub], q)) for q in (0, 50, 100)])
+    # distinct realised sizes per case over the severity steps (ladder)
+    per_case = {}
+    for r in sub:
+        if r.get("shift__Len_tot") is not None:
+            per_case.setdefault(r["case"], set()).add(round(r["shift__Len_tot"], 4))
+    out["median_distinct_sizes_per_case"] = float(np.median([len(v) for v in per_case.values()])) if per_case else None
+    return out
+
+
+def mt_kind(err):
+    from perturb import PERTURBATIONS
+    return PERTURBATIONS[err]["severity_kind"]
+
+
+def main():
+    report = {}
+    for ds, label, _ in mt.DATASETS:
+        rows = mt.load(ds)
+        report[ds] = {e: s for e in [e for e, _ in mt.ERRORS] if (s := summarize(rows, e))}
+    (OUT / "perturbation_validation.json").write_text(json.dumps(report, indent=1, default=str))
+    for ds, errs in report.items():
+        print(f"== {ds}")
+        for e, s in errs.items():
+            extra = {k: v for k, v in s.items() if k not in ("rows", "d_b0", "d_b1")}
+            print(f"  {e:22s} rows {s['rows']:5d}  d_b0 {s['d_b0']}  d_b1 {s['d_b1']}  {extra}")
+    print(f"-> {(OUT / 'perturbation_validation.json').relative_to(REPO)}")
+
+
+if __name__ == "__main__":
+    main()
