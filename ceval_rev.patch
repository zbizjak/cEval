+    i = int(np.searchsorted(a, t, side="right") - 1)
+    i = min(max(i, 0), len(path) - 2)
+    for j in (i, i + 1):
+        if abs(a[j] - t) < 1e-6:
+            return points, edges, j, path
+    u, v = path[i], path[i + 1]
+    f = (t - a[i]) / (a[i + 1] - a[i])
+    if f <= 1e-6 or f >= 1 - 1e-6:
+        return points, edges, (i if f < 0.5 else i + 1), path
+    q = len(points)
+    points = np.vstack([points, (1 - f) * points[u] + f * points[v]])
+    keep = ~(((edges[:, 0] == u) & (edges[:, 1] == v))
+             | ((edges[:, 0] == v) & (edges[:, 1] == u)))
+    edges = np.vstack([edges[keep], [[u, q], [q, v]]])
+    return points, edges, i + 1, path[:i + 1] + [q] + path[i + 1:]
 
 
