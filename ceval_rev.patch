+"""Response to one displaced junction against the realised displacement.
+
+Controlled sweep of step5_robustness/junction_sweep.py: per case one junction
+and one host branch, moved by 0.25-6 mm of arc. Lines are the median response
+per dataset at each requested level, plotted at the median realised
+displacement in units of tau; bands the interquartile range.
+
+    CEVAL_FIG_FORMAT=png python3 step4_figures/viz_junction.py
+"""
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import matplotlib
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt  # noqa: E402
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from config import REPO, RESULTS, FIGURES, TABLES, DATA, VOLUME2GRAPH  # noqa: E402,F401
+import figio  # noqa: E402  (lib/ is on the path only after config)
+from datasets import DATASET_LABELS  # noqa: E402
+
+PANELS = [("ASCD", "ASCD (mm)"), ("netmets_geom_F1", "NetMets geom. F1"), ("APLS", "APLS"),
+          ("junction_F1", "Junction F1"), ("HD95", "HD95 (mm)"), ("endpoint_F1", "Endpoint F1")]
+ORDER = ["synthetic", "topcow_mr", "topcow_ct", "aortaseg24", "imagecas"]
+LABEL = {**DATASET_LABELS, "synthetic": "Synthetic"}
+
+
+def main():
+    rows = json.loads((RESULTS / "robustness" / "junction" / "displacement.json").read_text())
+    colors = plt.cm.viridis(np.linspace(0.1, 0.85, len(ORDER)))
+    fig, axes = plt.subplots(2, 3, figsize=(10, 5.6), sharex=True)
+    for ax, (m, title) in zip(axes.flat, PANELS):
+        for ds, c in zip(ORDER, colors):
+            sub = [r for r in rows if r["dataset"] == ds and r.get(f"shift__{m}") is not None]
+            levels = sorted({r["requested_mm"] for r in sub})
+            x, med, lo, hi = [], [], [], []
+            for t in levels:
+                rs = [r for r in sub if r["requested_mm"] == t]
+                y = np.array([r[f"shift__{m}"] for r in rs])
+                y[np.abs(y) < 1e-9] = 0.0          # floating-point noise, not a response
+                x.append(np.median([r["realized_displacement_mm"] / r["tau"] for r in rs]))
+                med.append(np.median(y)); lo.append(np.percentile(y, 25)); hi.append(np.percentile(y, 75))
+            ax.plot(x, med, "-o", ms=3, color=c, label=LABEL.get(ds, ds), lw=1.5)
+            ax.fill_between(x, lo, hi, color=c, alpha=0.15, lw=0)
+        ax.axvline(1.0, color="#999999", ls="--", lw=0.8)
+        ax.set_title(title, fontsize=12)
+        ax.grid(alpha=0.3)
+    for ax in axes[1]:
+        ax.set_xlabel(r"realised displacement / $\tau$", fontsize=11)
+    for ax in axes[:, 0]:
+        ax.set_ylabel("response to the error", fontsize=11)
+    handles, labels = axes[0, 0].get_legend_handles_labels()
+    fig.legend(handles, labels, loc="lower center", ncol=5, fontsize=10, frameon=False,
+               bbox_to_anchor=(0.5, -0.02))
+    fig.tight_layout(rect=(0, 0.05, 1, 1))
+    print("->", figio.save(fig, FIGURES / "junction_displacement.png"))
+
+
+if __name__ == "__main__":
+    main()
