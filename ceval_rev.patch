+def _node_at_arc(points, edges, path, t):
+    """Node at arc length ``t`` along ``path``, inserting one if needed.
+
+    Returns (points, edges, k, path) with ``path[k]`` the node at ``t``. A new
+    node is placed on the edge at the interpolated point, so the polyline is
+    unchanged; a target within 1e-6 of an existing node reuses that node.
+    """
