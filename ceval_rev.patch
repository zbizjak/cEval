+"""Checks behind statements the revision makes about the score and the controls.
+
+  monotonicity  junction sweep: in how many cases does the response increase
+                strictly with the displacement; the lowest within-case rho and
+                every reversal
+  margins       smallest junction displacements: worst-case ratio of the
+                response to the numerical range, of the change between
+                adjacent displacements to the summed ranges, and whether the
+                value intervals of adjacent displacements ever overlap
+  paired_d      the score's d compares adjacent severity groups across cases
+                (unpaired). Each case is its own control, so a paired effect
+                size (mean within-case change over its SD) is the alternative;
+                best scores per dataset and the best triplet under both
+  severity_tau  every physical severity in units of each dataset's tau
+
+    python3 step5_robustness/diagnostics.py   # -> results/robustness/diagnostics.json
+"""
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+from scipy.stats import spearmanr
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from config import REPO, RESULTS, FIGURES, TABLES, DATA, VOLUME2GRAPH  # noqa: E402,F401
+
+import scoring as sc  # noqa: E402
+import selection as sel  # noqa: E402
+from scoring import mt  # noqa: E402
+
+ROB = RESULTS / "robustness"
+NOISE = 1e-9
+
+
+def monotonicity():
+    rows = json.loads((ROB / "junction" / "displacement.json").read_text())
+    out = {}
+    for m in ("ASCD", "netmets_geom_F1", "APLS"):
+        cases, strict, rhos, reversals = {}, 0, [], []
+        for r in rows:
+            cases.setdefault((r["dataset"], r["case"]), []).append(r)
+        for (ds, case), rs in cases.items():
+            rs.sort(key=lambda r: r["requested_mm"])
+            y = np.array([r[f"shift__{m}"] for r in rs])
+            y[np.abs(y) < NOISE] = 0.0
+            dy = np.diff(y)
+            strict += bool((dy > 0).all())
+            rhos.append(spearmanr([r["realized_displacement_mm"] for r in rs], y).statistic
+                        if np.ptp(y) > 0 else 0.0)
+            for i in np.flatnonzero(dy <= 0):
+                reversals.append({"dataset": ds, "case": case, "from_mm": rs[i]["requested_mm"],
+                                  "to_mm": rs[i + 1]["requested_mm"], "change": float(dy[i])})
+        out[m] = {"n_cases": len(cases), "strictly_increasing": strict, "min_rho": float(np.min(rhos)),
+                  "reversals": reversals}
+    return out
+
+
+def margins():
+    rows = json.loads((ROB / "junction" / "junction_numerics.json").read_text())
+    levels = ["0.25", "0.5", "0.75"]
+    out = {}
+    for m in ("netmets_geom_F1", "ASCD"):
+        resp_ratio, adj_ratio, overlaps = [], [], 0
+        for r in rows:
+            ivals = {}
+            for t in levels:
+                vals = [v[m] for v in r["levels"][t]["per_setting_values"].values() if v.get(m) is not None]
+                canon = r["levels"][t]["per_setting_values"]["div10|sub1|order"][m]
+                rng = float(np.ptp(vals))
+                ivals[t] = (min(vals), max(vals), canon, rng)
+                resp = abs(canon - r["baseline_values"][m])
+                if rng > 0:
+                    resp_ratio.append(resp / rng)
+            for a, b in zip(levels[:-1], levels[1:]):
+                lo_a, hi_a, ca, ra = ivals[a]
+                lo_b, hi_b, cb, rb = ivals[b]
+                if ra + rb > 0:
+                    adj_ratio.append(abs(cb - ca) / (ra + rb))
+                overlaps += not (hi_a < lo_b or hi_b < lo_a)
+        out[m] = {"min_response_over_range": float(np.min(resp_ratio)),
+                  "median_response_over_range": float(np.median(resp_ratio)),
+                  "min_adjacent_change_over_summed_ranges": float(np.min(adj_ratio)),
+                  "median_adjacent_change_over_summed_ranges": float(np.median(adj_ratio)),
+                  "overlapping_adjacent_intervals": overlaps, "n_cases": len(rows)}
+    return out
+
+
+def paired_d(arr, e, m):
+    d = arr.err[e]
+    y = d["shift"][m]
+    by = {}
+    for c, s, v in zip(d["case_i"], d["sev"], y):
+        if not np.isnan(v):
+            by.setdefault(int(c), {})[float(s)] = float(v)
+    sevs = sorted({float(s) for s in d["sev"]})
+    ds = []
+    for a, b in zip(sevs[:-1], sevs[1:]):
+        diff = np.array([v[b] - v[a] for v in by.values() if a in v and b in v])
+        if len(diff) < 3:
+            continue
+        sd = diff.std(ddof=1)
+        if sd > 1e-12:
+            ds.append(abs(diff.mean()) / sd)
+        else:
+            ds.append(np.inf if abs(diff.mean()) > NOISE else 0.0)
+    return float(np.median(ds)) if ds else np.nan
+
+
+def paired_vs_unpaired(cap=4.0):
+    arrays = sc.load_all()
+    res = {ds: sc.score_dataset(a, np.arange(len(a.cases)), caps=(cap,)) for ds, a in arrays.items()}
+    targets, inel, S_unp, cv = sel.build(res, cap)
+    S_pair = np.zeros_like(S_unp)
+    for j, (ds, e) in enumerate(targets):
+        for i, m in enumerate(sel.M):
+            c = res[ds][e]["cells"][m]
+            if c["rho"] is None or m not in arrays[ds].err[e]["shift"]:
+                continue
+            dz = paired_d(arrays[ds], e, m)
+            if np.isfinite(dz) or dz == np.inf:
+                S_pair[i, j] = max(0.0, c["rho"]) * min(1.0, dz / cap)
+    mask = sel.masks(targets, cv)["analytical"]
+    out = {}
+    for name, S in (("unpaired", S_unp), ("paired", S_pair)):
+        Sm = np.where(mask, 0.0, S)
+        best = Sm.max(0)
+        w = sel.weakest_error(targets, Sm)
+        out[name] = {"mean_best_S_by_dataset": w["mean_best_S_by_dataset"],
+                     "mean_best_S_by_error": w["mean_best_S"],
+                     "imagecas_best_S": {e: float(best[j]) for j, (ds, e) in enumerate(targets) if ds == "imagecas"},
+                     "exhaustive_best": sel.exhaustive3(Sm, np.ones(len(targets)), top=1)[0][0],
+                     "greedy": [sel.M[i] for i in sel.greedy(Sm, np.ones(len(targets)))[:3]]}
+    return out
+
+
+def severity_tau():
+    from datasets import d_mm
+    taus = {"synthetic": 0.7, **{ds: d_mm(ds) for ds in ("topcow_mr", "topcow_ct", "aortaseg24", "imagecas")}}
+    fixed = {"disconnection": 2.0, "false_component": 5.0, "false_loop": 6.0, "cycle_disconnection": 1.0,
+             "false_branch": 5.0, "spurious_bifurcation": 1.0, "bifurcation_shift": 3.0}
+    cont = [0.1, 0.25, 0.5, 0.75, 1.0, 1.5]
+    return {"tau_mm": taus,
+            "fixed_size_over_tau": {e: {ds: v / t for ds, t in taus.items()} for e, v in fixed.items()},
+            "continuous_max_over_tau": {ds: max(cont) / t for ds, t in taus.items()}}
+
+
+def main():
+    out = {"monotonicity": monotonicity(), "margins": margins(), "paired_vs_unpaired": paired_vs_unpaired(),
+           "severity_tau": severity_tau()}
+    (ROB / "diagnostics.json").write_text(json.dumps(out, indent=1))
+    for m, x in out["monotonicity"].items():
+        print(f"{m}: strictly increasing in {x['strictly_increasing']}/{x['n_cases']}, min rho {x['min_rho']:.3f}, "
+              f"reversals {[(r['case'], r['from_mm'], r['to_mm'], round(r['change'], 8)) for r in x['reversals']][:4]}")
+    for m, x in out["margins"].items():
+        print(f"{m}: response/range min {x['min_response_over_range']:.2f} (median {x['median_response_over_range']:.0f}); "
+              f"adjacent change/summed ranges min {x['min_adjacent_change_over_summed_ranges']:.2f} "
+              f"(median {x['median_adjacent_change_over_summed_ranges']:.0f}); overlapping {x['overlapping_adjacent_intervals']}")
+    for name, x in out["paired_vs_unpaired"].items():
+        print(f"{name:9s} mean best S by dataset {({k: round(v, 3) for k, v in x['mean_best_S_by_dataset'].items()})}; "
+              f"best triplet {x['exhaustive_best']}; greedy {x['greedy']}")
+        print(f"          ImageCAS {({k: round(v, 3) for k, v in x['imagecas_best_S'].items()})}")
+    print("continuous severities, max / tau:", {k: round(v, 2) for k, v in out["severity_tau"]["continuous_max_over_tau"].items()})
+    print(f"-> {(ROB / 'diagnostics.json').relative_to(REPO)}")
+
+
+if __name__ == "__main__":
+    main()
diff -ruN '--exclude=results' '--exclude=figures' '--exclude=tables' '--exclude=__pycache__' '--exclude=*.pdf' '--exclude=examples' '--exclude=images_v5' ceval/janniks/step5_robustness/junction_sweep.py ceval_rev/janniks/step5_robustness/junction_sweep.py
