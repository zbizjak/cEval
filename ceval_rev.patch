+        *rows, r"\bottomrule", r"\end{tabularx}",
+        r"\par\smallskip\parbox{\columnwidth}{\footnotesize Exhaustive, the best of all 969 triplets on the "
+        r"rest; Published, NetMets geom.\ F1 + endpoint F1 + total length.}",
+        r"\end{table}", ""])
+
+
+# ----------------------------------------------------------------- Table J
+def junction_table():
