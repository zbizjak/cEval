+"""Case-resampling bootstrap of the metric-set selection.
+
+Each replicate draws the cases of every dataset with replacement, keeping all
+severities and perturbation outcomes of a drawn case together, recomputes the
+whole score matrix (caps 4, 2, 1; same-constant transitions as d = 0), and
+reruns the selection under the CV and the analytical exclusion. TopCoW MR and
+TopCoW CT are the same patients (topcow_mr_NNN and topcow_ct_NNN), so they
+are resampled as pairs: one draw of patient ids, used for both modalities.
+
+Variants (targets kept in the selection objective):
+  paired     all five datasets, TopCoW drawn by patient       [primary]
+  mr_only    TopCoW CT left out                               [sensitivity]
+  ct_only    TopCoW MR left out                               [sensitivity]
+
+Per replicate and (variant, cap, policy) it records the greedy order, the
+exhaustive top-5 triplets and the coverage of the published, greedy and
+exhaustive triplets; the score ingredients (rho, d, CV flag, ladder) are
+saved as well, so other summaries need no new draws.
+
+    python3 step5_robustness/bootstrap.py --n 1000 --nproc 22
+"""
+import os
+
+for _v in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS"):
+    os.environ.setdefault(_v, "1")
+
+import argparse  # noqa: E402
+import json  # noqa: E402
+import sys  # noqa: E402
+import time  # noqa: E402
+from collections import Counter  # noqa: E402
+import multiprocessing  # noqa: E402
+from concurrent.futures import ProcessPoolExecutor  # noqa: E402
+from pathlib import Path  # noqa: E402
+
+import numpy as np  # noqa: E402
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from config import REPO, RESULTS, FIGURES, TABLES, DATA, VOLUME2GRAPH  # noqa: E402,F401
+
+import scoring as sc  # noqa: E402
+import selection as sel  # noqa: E402
+
+OUT = sel.OUT / "bootstrap"
+OUT.mkdir(parents=True, exist_ok=True)
+M = sc.METRICS
+CAPS = sel.CAPS
+POLICIES = ("cv", "analytical")
+PAIRED = ("topcow_mr", "topcow_ct")
+VARIANTS = {"paired": set(sc.DATASETS),
+            "mr_only": set(sc.DATASETS) - {"topcow_ct"},
+            "ct_only": set(sc.DATASETS) - {"topcow_mr"}}
+
+_ARRAYS, _TARGETS = None, None
+
+
+def _init():
+    global _ARRAYS, _TARGETS
+    _ARRAYS = sc.load_all()
+    _TARGETS = [(ds, e) for ds in sc.DATASETS if ds in _ARRAYS for e in _ARRAYS[ds].errors]
+
+
+def patient_ids(arr):
+    return [c.split("_")[-1] for c in arr.cases]
+
+
+def draw(rng, arrays):
+    """Case indices per dataset; TopCoW MR and CT share one draw of patients."""
+    out = {ds: rng.integers(0, len(a.cases), len(a.cases))
+           for ds, a in arrays.items() if ds not in PAIRED}
+    mr, ct = arrays["topcow_mr"], arrays["topcow_ct"]
+    assert patient_ids(mr) == patient_ids(ct), "TopCoW MR/CT case lists are not paired"
+    shared = rng.integers(0, len(mr.cases), len(mr.cases))
+    out["topcow_mr"] = out["topcow_ct"] = shared
+    return out
+
+
+def replicate(draws):
+    """Score ingredients and selections for one replicate."""
+    T = len(_TARGETS)
+    tj = {t: j for j, t in enumerate(_TARGETS)}
+    rho = np.full((len(M), T), np.nan, np.float32)
+    dmat = {cap: np.full((len(M), T), np.nan, np.float32) for cap in CAPS}
+    smat = {cap: np.zeros((len(M), T)) for cap in CAPS}
+    cv = np.zeros((len(M), T), bool)
+    ladder = np.zeros(T, bool)
+    for ds, arr in _ARRAYS.items():
+        res = sc.score_dataset(arr, draws[ds], caps=CAPS)
+        for e, er in res.items():
+            j = tj[(ds, e)]
+            ladder[j] = er["ladder"]
+            for i, m in enumerate(M):
+                c = er["cells"][m]
+                cv[i, j] = c["cv_flag"]
+                if c["rho"] is not None:
+                    rho[i, j] = c["rho"]
+                for cap in CAPS:
+                    d = c["d"].get(("zero", cap))
+                    if d is not None:
+                        dmat[cap][i, j] = d
+                    s = c["score"].get(("zero", cap))
+                    smat[cap][i, j] = s if s is not None else 0.0
+    picks = {}
+    for v, keep in VARIANTS.items():
+        cols = [j for j, t in enumerate(_TARGETS) if ladder[j] and t[0] in keep]
+        tg = [_TARGETS[j] for j in cols]
+        mk = sel.masks(tg, cv[:, cols])
+        w = np.ones(len(cols))
+        for cap in CAPS:
+            S_raw = smat[cap][:, cols]
+            for pol in POLICIES:
+                S_m = np.where(mk[pol], 0.0, S_raw)
+                ceil = float(S_m.max(0).sum())
+                g = sel.greedy(S_m, w)
+                ex = sel.exhaustive3(S_m, w, top=5)
+                best = S_m.max(0)
+                bif = [best[k] for k, t in enumerate(tg) if t[1] == "bifurcation_shift"]
+                rec = {"greedy": [M[i] for i in g], "exhaustive_top5": [[list(s), c] for s, c in ex]}
+                for name, ix in (("published", sel.idx_of(sel.PUBLISHED)), ("greedy3", g[:3]),
+                                 ("exhaustive", sel.idx_of(ex[0][0]))):
+                    rec[f"cov_{name}"] = sel.cov(S_m, ix, w) / ceil if ceil else None
+                rec["bif_shift_mean_best"] = float(np.mean(bif)) if bif else None
+                per_err = {}
+                for k, t in enumerate(tg):
+                    per_err.setdefault(t[1], []).append(best[k])
+                rec["weakest_error"] = min(per_err, key=lambda e: np.mean(per_err[e]))
+                picks[f"{v}|cap{cap:g}|{pol}"] = rec
+    return rho, dmat, cv, ladder, picks
+
+
+def summarize(recs, n):
+    out = {}
+    for key in recs[0]:
+        rs = [r[key] for r in recs]
+        pct = lambda name: [float(np.nanpercentile([np.nan if x[name] is None else x[name] for x in rs], p))
+                            for p in (2.5, 50, 97.5)]
+        inc = Counter(m for x in rs for m in x["exhaustive_top5"][0][0])
+        pub = tuple(sorted(sel.PUBLISHED))
+        out[key] = {
+            "inclusion_in_exhaustive_best": {m: c / n for m, c in inc.most_common()},
+            "exhaustive_best_freq": [[list(k), c / n] for k, c in
+                                     Counter(tuple(x["exhaustive_top5"][0][0]) for x in rs).most_common(5)],
+            "greedy_triplet_freq": [[list(k), c / n] for k, c in
+                                    Counter(tuple(sorted(x["greedy"][:3])) for x in rs).most_common(5)],
+            "greedy_first3_ordered_freq": [[list(k), c / n] for k, c in
+                                           Counter(tuple(x["greedy"][:3]) for x in rs).most_common(3)],
+            # endpoint F1 together with a curve-distance metric (ASCD or NetMets geom. F1)
+            "core_in_exhaustive_best": sum("endpoint_F1" in x["exhaustive_top5"][0][0]
+                                           and bool({"ASCD", "netmets_geom_F1"} & set(x["exhaustive_top5"][0][0]))
+                                           for x in rs) / n,
+            "greedy_is_published": sum(tuple(sorted(x["greedy"][:3])) == pub for x in rs) / n,
+            "greedy_is_exhaustive_best": sum(tuple(sorted(x["greedy"][:3])) == tuple(x["exhaustive_top5"][0][0])
+                                             for x in rs) / n,
+            "weakest_error_freq": {e: c / n for e, c in Counter(x["weakest_error"] for x in rs).most_common()},
+            **{f"{q}_p2.5_p50_p97.5": pct(q) for q in ("cov_published", "cov_greedy3", "cov_exhaustive",
+                                                        "bif_shift_mean_best")},
+        }
+    return out
+
+
+def multiplicity_test(arrays):
+    """A case drawn twice contributes twice, also to has_ladder."""
+    arr, e = arrays["topcow_mr"], "disconnection"
+    idx, draw_id = arr.index(np.array([0, 0, 1]))[e]
+    n0 = len(arr.err[e]["rows_of_case"][0])
+    assert len(idx) == 2 * n0 + len(arr.err[e]["rows_of_case"][1])
+    assert len(np.unique(draw_id)) == 3
+    return "multiplicity test passed"
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--n", type=int, default=1000)
+    ap.add_argument("--seed", type=int, default=20261014)
+    ap.add_argument("--nproc", type=int, default=22)
+    args = ap.parse_args()
+
+    _init()
+    print(multiplicity_test(_ARRAYS))
+    rng = np.random.default_rng(args.seed)
+    all_draws = [draw(rng, _ARRAYS) for _ in range(args.n)]   # fixed before any work is split
+    t0 = time.time()
+    # workers are forked after the arrays are loaded and share them
+    with ProcessPoolExecutor(max_workers=args.nproc,
+                             mp_context=multiprocessing.get_context("fork")) as ex:
+        res = list(ex.map(replicate, all_draws, chunksize=max(1, args.n // (4 * args.nproc))))
+    print(f"{args.n} replicates in {time.time() - t0:.0f} s")
+
+    tag = f"n{args.n}"
+    np.savez_compressed(
+        OUT / f"matrices_{tag}.npz", metrics=np.array(M), seed=args.seed,
+        targets=np.array([f"{a}|{b}" for a, b in _TARGETS]),
+        rho=np.stack([r[0] for r in res]), cv=np.stack([r[2] for r in res]),
+        ladder=np.stack([r[3] for r in res]),
+        **{f"d_cap{cap:g}": np.stack([r[1][cap] for r in res]) for cap in CAPS},
+        **{f"draws_{ds}": np.stack([d[ds] for d in all_draws]).astype(np.int16) for ds in _ARRAYS})
+    recs = [r[4] for r in res]
+    with open(OUT / f"replicates_{tag}.jsonl", "w") as f:
+        for r in recs:
+            f.write(json.dumps(r) + "\n")
+    summ = {"n": args.n, "seed": args.seed, "variants": {k: sorted(v) for k, v in VARIANTS.items()},
+            "summary": summarize(recs, args.n)}
+    (OUT / f"summary_{tag}.json").write_text(json.dumps(summ, indent=1))
+
+    s = summ["summary"]
+    for pol in POLICIES:
+        print(f"\n== {pol}: share of replicates with the metric in the exhaustive best triplet")
+        print(f"   {'':20s}" + "".join(f"{f'cap{c:g} ' + v:>18s}" for c in CAPS for v in ("paired",)))
+        shown = ("endpoint_F1", "ASCD", "netmets_geom_F1", "junction_F1", "branch_coverage_F1", "Len_tot")
+        for m in shown:
+            print(f"   {m:20s}" + "".join(
+                f"{s[f'paired|cap{c:g}|{pol}']['inclusion_in_exhaustive_best'].get(m, 0):>18.3f}" for c in CAPS))
+        for c in CAPS:
+            k = f"paired|cap{c:g}|{pol}"
+            print(f"   cap{c:g}: modal best {s[k]['exhaustive_best_freq'][0]}, greedy = published "
+                  f"{s[k]['greedy_is_published']:.3f}, published cov p2.5/50/97.5 "
+                  f"{[round(x, 3) for x in s[k]['cov_published_p2.5_p50_p97.5']]}, "
+                  f"bif. shift mean best {[round(x, 3) for x in s[k]['bif_shift_mean_best_p2.5_p50_p97.5']]}")
+    print(f"\n-> {OUT.relative_to(REPO)}/summary_{tag}.json, replicates_{tag}.jsonl, matrices_{tag}.npz")
+
+
+if __name__ == "__main__":
+    main()
