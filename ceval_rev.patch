+def line(prefix, new):
+    """Replace the whole line that starts with prefix."""
+    global t
+    lines = t.split("\n")
+    hits = [i for i, l in enumerate(lines) if l.startswith(prefix)]
+    if len(hits) != 1:
+        sys.exit(f"expected one line starting with {prefix[:70]!r}, found {len(hits)}")
+    lines[hits[0]] = new
+    t = "\n".join(lines)
+
