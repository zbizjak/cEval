+"""Toy-graph checks for the three perturbation repairs.
+
+  1. error_length_mm is the length actually added or removed: the change in
+     total edge length, boundary edges included.
+  2. bifurcation_shift moves the junction by exactly the requested arc length,
+     moves no other landmark, keeps b0 and b1, makes no coincident nodes and
+     does not fold the host branch back on itself (also on a short arm and on
+     two junctions 0.6 mm apart, which broke earlier repairs).
+  3. cycle_disconnection removes one cycle per applied cut and never splits a
+     component, also on a theta graph whose basis cycles share edges.
+
+    python3 tests/test_perturb_fixes.py
+"""
+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from config import REPO, RESULTS, FIGURES, TABLES, DATA, VOLUME2GRAPH  # noqa: E402,F401
+
+from perturb import apply_perturbation, adjacency, betti, edge_length  # noqa: E402
+
+
+def chain(start, coords, edges, pts):
+    idx = []
+    for q in coords:
+        pts.append(q)
+        idx.append(len(pts) - 1)
+    prev = start
+    for i in idx:
+        edges.append((prev, i))
+        prev = i
+    return idx
+
+
+def y_graph(curved=False, short_arm=False, n=21):
+    s, pts, e = 0.3, [(0.0, 0.0, 0.0)], []
+    chain(0, [(-s * i, 0, 0) for i in range(1, n)], e, pts)
+    if curved:
+        r = 6.0
+        a = [(r * np.sin(s * i / r), r * (1 - np.cos(s * i / r)), 0) for i in range(1, 21)]
+        b = [(r * np.sin(s * i / r), -r * (1 - np.cos(s * i / r)), 0) for i in range(1, 21)]
+    else:
+        a = [(s * i / np.sqrt(2), s * i / np.sqrt(2), 0) for i in range(1, n)]
+        b = [(s * i / np.sqrt(2), -s * i / np.sqrt(2), 0) for i in range(1, 4 if short_arm else n)]
+    chain(0, a, e, pts)
+    chain(0, b, e, pts)
+    return np.array(pts, float), np.array(e)
+
+
+def close_junctions():
+    pts, e = [(0.0, 0, 0)], []
+    trunk = chain(0, [(0.3 * i, 0, 0) for i in range(1, 41)], e, pts)
+    j1, j2 = trunk[19], trunk[21]
+    chain(j1, [(pts[j1][0], 0.3 * k, 0) for k in range(1, 21)], e, pts)
+    chain(j2, [(pts[j2][0], -0.3 * k, 0) for k in range(1, 21)], e, pts)
+    return np.array(pts, float), np.array(e)
+
+
+def theta_with_ring():
+    """Two junctions joined by three 30-node paths (two overlapping basis
+    cycles), plus a separate ring: three independent cycles in two components."""
+    pts, e = [(0.0, 0, 0), (9.0, 0, 0)], []
+    for y in (-2.0, 0.0, 2.0):
+        mid = chain(0, [(0.3 * i, y * np.sin(np.pi * i / 30), 0) for i in range(1, 30)], e, pts)
+        e.append((mid[-1], 1))
+    start = len(pts)
+    for k in range(40):
+        t = 2 * np.pi * k / 40
+        pts.append((20 + 2 * np.cos(t), 2 * np.sin(t), 0))
+    e += [(start + k, start + (k + 1) % 40) for k in range(40)]
+    return np.array(pts, float), np.array(e)
+
+
+def main():
+    fails = []
+
+    # 1. realised lengths (arms long enough for a 6 mm false loop)
+    p, e = y_graph(n=60)
+    for err in ("disconnection", "false_component", "false_loop", "missing_branch",
+                "false_branch", "spurious_bifurcation"):
+        q, f, info = apply_perturbation(err, p, e, 1, seed=0)
+        true = abs(edge_length(q, f) - edge_length(p, e))
+        if not info["n_applied"] or abs(info["error_length_mm"] - true) > 1e-6:
+            fails.append(f"{err}: error_length_mm {info.get('error_length_mm')} vs edge diff {true}")
+    print(f"1. realised lengths: {'OK' if not fails else 'FAIL'}")
+
+    # 2. bifurcation shift
+    graphs = {"straight Y": y_graph(), "curved Y": y_graph(curved=True),
+              "short arm": y_graph(short_arm=True), "close junctions": close_junctions()}
+    n_ops = 0
+    for name, (p, e) in graphs.items():
+        adj = adjacency(len(p), e)
+        landmarks = [i for i in range(len(p)) if len(adj[i]) != 2]
+        sev = 2 if name == "close junctions" else 1
+        for seed in range(5):
+            for target in (0.25, 1.0, 2.37, 3.0, 4.5):
+                q, f, info = apply_perturbation("bifurcation_shift", p, e, sev, seed=seed,
+                                                shift_mm=target)
+                ops = info.get("ops", [])
+                n_ops += len(ops)
+                shifted = {o["old_junction"] for o in ops}
+                moved = [i for i in landmarks if i not in shifted
+                         and np.linalg.norm(q[i] - p[i]) > 1e-9]
+                coinc = sum(np.linalg.norm(q[i] - q[k]) < 1e-9
+                            for i in range(len(q)) for k in range(i + 1, len(q)))
+                arc_err = max((abs(o["arc_along_host_mm"] - target) for o in ops), default=0.0)
+                # no fold: the shift adds no length beyond the re-attached
+                # branches' change of root, which is below the displacement
+                d_len = edge_length(q, f) - edge_length(p, e)
+                if (moved or coinc or betti(len(p), e) != betti(len(q), f) or arc_err > 1e-9
+                        or d_len > info["displacement_mm"] + 1e-9):
+                    fails.append(f"bifurcation_shift {name} seed {seed} target {target}: moved "
+                                 f"{moved}, coincident {coinc}, arc error {arc_err:.2e}, "
+                                 f"length change {d_len:.3f}")
+    print(f"2. bifurcation shift ({n_ops} operations): "
+          f"{'OK' if not any('bifurcation' in x for x in fails) else 'FAIL'}")
+
+    # 3. cycle disconnection
+    p, e = theta_with_ring()
+    b0, b1 = betti(len(p), e)
+    for sev in (1, 2, 3, 4):
+        q, f, info = apply_perturbation("cycle_disconnection", p, e, sev, seed=0)
+        n = info["n_applied"]
+        if betti(len(q), f) != (b0, b1 - n) or n != min(sev, b1):
+            fails.append(f"cycle_disconnection severity {sev}: applied {n}, "
+                         f"betti {betti(len(q), f)} from {(b0, b1)}")
+    print(f"3. cycle disconnection: "
+          f"{'OK' if not any('cycle' in x for x in fails) else 'FAIL'}")
+
+    for x in fails:
+        print("   ", x)
+    print("ALL CHECKS PASSED" if not fails else f"{len(fails)} FAILURES")
+    sys.exit(1 if fails else 0)
+
+
+if __name__ == "__main__":
+    main()
