+"""Join hard-wrapped prose lines of a LaTeX file into one line per paragraph.
+
+Never joins: blank lines, lines with an unescaped %, lines starting with a
+structural command, or anything inside math/tabular/verbatim environments.
+--check verifies that the output differs from the input only by whitespace
+inside paragraphs (blank-line paragraph breaks and comment lines preserved).
+"""
+import re
+import sys
+
+STRUCT = re.compile(r"^\s*\\(begin|end|section|subsection|subsubsection|paragraph|item|label|caption|"
+                    r"includegraphics|centering|input|include|documentclass|usepackage|newcommand|"
+                    r"renewcommand|author|address|journal|title|bibliography|bibliographystyle|appendix|"
+                    r"clearpage|newpage|hypersetup|graphicspath|maketitle|tableofcontents|noindent|vspace|"
+                    r"hline|toprule|midrule|bottomrule|\[|\])")
+SKIP_ENVS = ("equation", "equation*", "align", "align*", "tabular", "tabularx", "tabular*", "longtable",
+             "verbatim", "gather", "multline", "array", "threeparttable", "tablenotes", "figure", "figure*",
+             "table", "table*")
+COMMENT = re.compile(r"(?<!\\)%")
+
+
+def joinable(line):
+    s = line.strip()
+    return bool(s) and not s.startswith("%") and not COMMENT.search(line) and not STRUCT.match(line) \
+        and not s.endswith("\\\\")
+
+
+def reflow(lines):
+    out, depth = [], []
+    i = 0
+    while i < len(lines):
+        line = lines[i]
+        for m in re.finditer(r"\\(begin|end)\{([^}]*)\}", line):
+            if m.group(2) in SKIP_ENVS:
+                if m.group(1) == "begin":
+                    depth.append(m.group(2))
+                elif depth:
+                    depth.pop()
+        if depth or not joinable(line):
+            out.append(line)
+            i += 1
+            continue
+        cur = line.rstrip()
+        while i + 1 < len(lines) and joinable(lines[i + 1]) and "\\begin{" not in lines[i + 1]:
+            i += 1
+            cur += " " + lines[i].strip()
+        out.append(cur)
+        i += 1
+    return out
+
+
+def normalise(text):
+    paras = re.split(r"\n[ \t]*\n", text)
+    return [re.sub(r"[ \t\n]+", " ", p.strip()) for p in paras]
+
+
+if __name__ == "__main__":
+    src, dst = sys.argv[1], sys.argv[2]
+    text = open(src).read()
+    new = "\n".join(reflow(text.split("\n")))
+    a, b = normalise(text), normalise(new)
+    assert a == b, "content changed beyond whitespace"
+    # comment lines must survive verbatim
+    ca = [l for l in text.split("\n") if COMMENT.search(l)]
+    cb = [l for l in new.split("\n") if COMMENT.search(l)]
+    assert ca == cb, "comment lines changed"
+    open(dst, "w").write(new)
+    print(f"{len(text.splitlines())} -> {len(new.splitlines())} lines; paragraphs {len(a)}; whitespace-only: OK")
