@@ -0,0 +1,219 @@
+"""The sensitivity score of make_tables, vectorised for resampling.
+
+Same score as make_tables.cell: S = max(0, rho) * min(1, d / cap), with rho
+the Spearman correlation of a metric's shift with the realised error size and
+d the median Cohen's d between adjacent severities. What this module adds:
+
+  * cap is a parameter, so caps 4, 2 and 1 come from one pass;
+  * zero_policy for adjacent groups that are the same constant (both all
+    zero, typically): "zero" counts them as d = 0, as make_tables now does;
+    "omit" skips them, as the first version did;
+  * rows are addressed through an index array that may repeat a case, and
+    has_ladder groups by draw, not by case id, so a case drawn twice in a
+    bootstrap replicate counts twice there too.
+
+Every cell carries a status, so an ineligible target (no severity ladder,
+metric not computed) stays distinguishable from a measured zero.
+
+    python3 step5_robustness/scoring.py     # regression check against make_tables
+"""
+import sys
+from pathlib import Path
+
+import numpy as np
+from scipy.stats import spearmanr
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from config import REPO, RESULTS, FIGURES, TABLES, DATA, VOLUME2GRAPH  # noqa: E402,F401
+
+import make_tables as mt  # noqa: E402
+from analyse_response import magnitude  # noqa: E402
+
+METRICS = list(mt.ALL_METRICS)
+ERRORS = [e for e, _ in mt.ERRORS]
+DATASETS = [k for k, _, _ in mt.DATASETS]
+
+
+class DatasetArrays:
+    """One dataset's sweep rows as per-error numpy arrays."""
+
+    def __init__(self, name, rows):
+        self.name = name
+        self.cases = sorted({r["case"] for r in rows})
+        cidx = {c: i for i, c in enumerate(self.cases)}
+        self.metrics = [m for m in METRICS if f"shift__{m}" in rows[0]]
+        self.has_probe = "shift__Len_tot" in rows[0]
+        self.errors = [e for e in ERRORS if any(r["error"] == e for r in rows)]
+        self.err = {}
+        for e in self.errors:
+            sub = [r for r in rows if r["error"] == e]
+            case_i = np.array([cidx[r["case"]] for r in sub])
+            d = {"case_i": case_i,
+                 "sev": np.array([float(r["severity"]) for r in sub]),
+                 "mag": np.array([magnitude(r) for r in sub]),
+                 "shift": {m: np.array([np.nan if r.get(f"shift__{m}") is None
+                                        else float(r[f"shift__{m}"]) for r in sub])
+                           for m in self.metrics}}
+            if self.has_probe:
+                # python round(), exactly as has_ladder does it
+                d["probe_r"] = np.array([np.nan if r.get("shift__Len_tot") is None
+                                         else round(r["shift__Len_tot"], 4) for r in sub])
+            order = np.argsort(case_i, kind="stable")
+            bounds = np.searchsorted(case_i[order], np.arange(len(self.cases) + 1))
+            d["rows_of_case"] = [order[bounds[i]:bounds[i + 1]]
+                                 for i in range(len(self.cases))]
+            self.err[e] = d
+
+    def index(self, draws):
+        """Row indices and draw ids for a list of drawn case indices."""
+        out = {}
+        for e, d in self.err.items():
+            parts = [d["rows_of_case"][c] for c in draws]
+            lens = np.fromiter((len(p) for p in parts), int, len(parts))
+            out[e] = (np.concatenate(parts) if parts else np.zeros(0, int),
+                      np.repeat(np.arange(len(draws)), lens))
+        return out
+
+
+def has_ladder(d, idx, draw_id, has_probe=True):
+    """make_tables.has_ladder, with draws in place of case ids."""
+    if not has_probe:
+        return True
+    pr = d["probe_r"][idx]
+    ok = ~np.isnan(pr)
+    if not ok.any():
+        return True
+    pairs = np.unique(np.stack([draw_id[ok].astype(float), pr[ok]], axis=1), axis=0)
+    _, n_levels = np.unique(pairs[:, 0], return_counts=True)
+    return float(np.median(n_levels)) >= mt.LADDER_MIN
+
+
+def transitions(y, sev):
+    """Every adjacent-severity transition with its kind and d (cap-free:
+    a constant-but-different transition is stored as d = inf)."""
+    out = []
+    sevs = np.unique(sev)
+    for a_s, b_s in zip(sevs[:-1], sevs[1:]):
+        a, b = y[sev == a_s], y[sev == b_s]
+        if len(a) < 3 or len(b) < 3:
+            out.append(("too_small", None))
+            continue
+        gap = abs(b.mean() - a.mean())
+        sd = np.sqrt((a.var(ddof=1) + b.var(ddof=1)) / 2)
+        if sd > 1e-12:
+            out.append(("normal", float(gap / sd)))
+        elif gap > 1e-9:
+            out.append(("const_different", np.inf))
+        else:
+            out.append(("const_identical", 0.0))
+    return out
+
+
+def median_d(trans, cap, zero_policy="zero"):
+    ds = []
+    for kind, d in trans:
+        if kind == "normal":
+            ds.append(d)
+        elif kind == "const_different":
+            ds.append(cap)
+        elif kind == "const_identical" and zero_policy == "zero":
+            ds.append(0.0)
+    return float(np.median(ds)) if ds else np.nan
+
+
+def constant_shift(y, sev):
+    """make_tables.is_constant_shift: median within-step CV below CV_FLOOR."""
+    cvs = []
+    for s in np.unique(sev):
+        v = y[sev == s]
+        if len(v) < 3 or not np.isfinite(v).all() or abs(v.mean()) < 1e-9:
+            continue
+        cvs.append(v.std(ddof=1) / abs(v.mean()))
+    return bool(cvs) and float(np.median(cvs)) < mt.CV_FLOOR
+
+
+def cell(d, m, idx, ladder, caps=(4.0,), zero_policies=("zero",)):
+    """rho, the CV flag, and d / score for every (zero_policy, cap)."""
+    res = {"status": None, "rho": None, "cv_flag": False, "d": {}, "score": {}}
+    if m not in d["shift"]:
+        res["status"] = "no_metric"
+        return res
+    y, sev, x = d["shift"][m][idx], d["sev"][idx], d["mag"][idx]
+    ok = ~np.isnan(y)
+    y, sev, x = y[ok], sev[ok], x[ok]
+    res["cv_flag"] = constant_shift(y, sev)
+    if not ladder:
+        res["status"] = "no_ladder"
+    elif len(y) < 6 or x.std() < 1e-12 or len(np.unique(sev)) < 2:
+        res["status"] = "insufficient"
+    elif not np.isfinite(y).all() or y.max() < 1e-9:
+        res["status"] = "no_response"
+    if res["status"]:
+        return res
+    with np.errstate(all="ignore"):
+        rho = spearmanr(x, y).statistic
+    res["rho"] = float(rho) if np.isfinite(rho) else None
+    tr = transitions(y, sev)
+    for zp in zero_policies:
+        for cap in caps:
+            dv = median_d(tr, cap, zp)
+            res["d"][(zp, cap)] = dv if np.isfinite(dv) else None
+            res["score"][(zp, cap)] = (None if res["rho"] is None or not np.isfinite(dv)
+                                       else max(0.0, res["rho"]) * min(1.0, dv / cap))
+    res["status"] = "scored" if res["rho"] is not None else "rho_undefined"
+    return res
+
+
+def score_dataset(arr, draws, caps=(4.0,), zero_policies=("zero",)):
+    """{error: {"ladder": bool, "cells": {metric: cell}}} for one (possibly
+    resampled) dataset."""
+    ix = arr.index(draws)
+    out = {}
+    for e in arr.errors:
+        idx, draw_id = ix[e]
+        d = arr.err[e]
+        lad = has_ladder(d, idx, draw_id, arr.has_probe)
+        out[e] = {"ladder": lad,
+                  "cells": {m: cell(d, m, idx, lad, caps, zero_policies) for m in METRICS}}
+    return out
+
+
+def load_all():
+    rows = {ds: mt.load(ds) for ds in DATASETS}
+    return {ds: DatasetArrays(ds, r) for ds, r in rows.items() if r}
+
+
+def check_against_make_tables(arrays):
+    """Every case drawn once must reproduce make_tables exactly: score,
+    has_ladder and the CV flag, at make_tables' own cap."""
+    worst, n, mismatches = 0.0, 0, []
+    for ds, arr in arrays.items():
+        rows = mt.load(ds)
+        res = score_dataset(arr, np.arange(len(arr.cases)), caps=(mt.D_CAP,))
+        for e in arr.errors:
+            if res[e]["ladder"] != mt.has_ladder(rows, e):
+                mismatches.append((ds, e, "has_ladder"))
+            for m in METRICS:
+                c = res[e]["cells"][m]
+                ref = mt.score(rows, m, e)
+                mine = c["score"].get(("zero", mt.D_CAP))
+                n += 1
+                if (ref is None) != (mine is None):
+                    mismatches.append((ds, e, m, "score", ref, mine, c["status"]))
+                elif ref is not None:
+                    worst = max(worst, abs(ref - mine))
+                if (f"shift__{m}" in rows[0]
+                        and c["cv_flag"] != mt.is_constant_shift(rows, m, e)):
+                    mismatches.append((ds, e, m, "cv_flag"))
+    return {"n_cells": n, "max_abs_score_diff": worst, "mismatches": mismatches}
+
+
+if __name__ == "__main__":
+    arrays = load_all()
+    chk = check_against_make_tables(arrays)
+    print(f"regression check at cap {mt.D_CAP:g}: {chk['n_cells']} cells, "
+          f"max |score diff| = {chk['max_abs_score_diff']:.2e}, "
+          f"{len(chk['mismatches'])} mismatches")
+    for x in chk["mismatches"][:20]:
+        print("  ", x)
+    sys.exit(1 if chk["mismatches"] or chk["max_abs_score_diff"] > 1e-12 else 0)
diff -ruN '--exclude=results' '--exclude=figures' '--exclude=tables' '--exclude=__pycache__' '--exclude=*.pdf' '--exclude=examples' '--exclude=images_v5' ceval/janniks/step5_robustness/selection.py ceval_rev/janniks/step5_robustness/selection.py
