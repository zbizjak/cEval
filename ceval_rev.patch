+              r"-- & -- & " + "; ".join(f"{ERR_LONG[e].lower()} {x:.3f}" for e, x in w) + r" \\"]
+    return "\n".join([
+        r"\begin{table*}[t]", r"\centering",
+        r"\caption{The metric set at caps 4, 2 and 1 on Cohen's $d$, circular pairs excluded. "
+        r"Coverage is relative to the best that all nineteen metrics reach.}",
+        r"\label{tab:cap}", r"\scriptsize", r"\setlength{\tabcolsep}{4pt}",
+        r"\begin{tabularx}{\textwidth}{@{}c>{\raggedright\arraybackslash}X>{\raggedright\arraybackslash}p{0.17\textwidth}"
+        r"c>{\raggedright\arraybackslash}p{0.17\textwidth}>{\raggedright\arraybackslash}p{0.2\textwidth}@{}}",
+        r"\toprule",
+        r"Cap & Greedy order (gain) & Best triplet (coverage) & Published & Bootstrap: modal best triplet; core & "
+        r"Weakest errors (mean best $S$) \\",
+        r"\midrule", *lines, r"\bottomrule", r"\end{tabularx}",
+        r"\par\smallskip\parbox{\textwidth}{\footnotesize Published, NetMets geom.\ F1 + endpoint F1 + total "
+        r"length. Bootstrap, 1000 replicates with TopCoW MR and CT drawn together by patient; core, share of "
+        r"replicates whose best triplet contains endpoint F1 and ASCD or NetMets geom.\ F1. Endp., endpoint F1; "
+        r"Junc., junction F1; BrCov, branch coverage F1; BrCount, branch count ratio.}",
+        r"\end{table*}", ""])
+
+
+def per_error_cap_table():
+    """Best non-circular metric and its score for every error and dataset at
+    caps 4, 2 and 1; a metric name in bold differs from the one at cap 4."""
+    arrays = sc.load_all()
+    caps = (4.0, 2.0, 1.0)
+    res = {ds: sc.score_dataset(a, np.arange(len(a.cases)), caps=caps) for ds, a in arrays.items()}
+    best = {}
+    for ds, r in res.items():
+        for e, er in r.items():
+            if not er["ladder"]:
+                continue
+            for cap in caps:
+                cand = [(c["score"].get(("zero", cap)) or 0.0, m) for m, c in er["cells"].items()
+                        if (m, e) not in mt.CIRCULAR_PAIRS and c["score"].get(("zero", cap)) is not None]
+                if cand:
+                    best[(ds, e, cap)] = max(cand)
+    out = []
+    for e, _ in mt.ERRORS:
+        if not any((ds, e, 4.0) in best for ds in sc.DATASETS):
+            continue
+        for ci, cap in enumerate(caps):
+            cells, vals = [], []
+            for ds in sc.DATASETS:
+                if (ds, e, cap) not in best:
+                    cells.append(r"\textcolor{gray}{n/s}" if e in res.get(ds, {}) else "--")
+                    continue
+                v, m = best[(ds, e, cap)]
+                vals.append(v)
+                name = SHORT.get(m, m)
+                if cap != 4.0 and best[(ds, e, 4.0)][1] != m:
+                    name = rf"\textbf{{{name}}}"
+                cells.append(rf"{v:.3f}\,{{\tiny {name}}}")
+            lead = rf"\multirow{{3}}{{*}}{{{ERR_LONG[e]}}}" if ci == 0 else ""
+            out.append(rf"{lead} & {cap:g} & " + " & ".join(cells) + rf" & {np.mean(vals):.3f} \\")
+        out.append(r"\addlinespace[2pt]")
+    return "\n".join([
+        r"\begin{table*}[t]", r"\centering",
+        r"\caption{Best score $S$ reached by any metric for every error and dataset, and the metric that "
+        r"reaches it, with $d$ capped at 4, 2 and 1. Circular pairs excluded.}",
+        r"\label{tab:cap-errors}", r"\scriptsize", r"\setlength{\tabcolsep}{3pt}",
+        r"\renewcommand{\arraystretch}{0.92}",
+        r"\begin{tabular*}{\textwidth}{@{\extracolsep{\fill}}lcccccc|c@{}}", r"\toprule",
+        r"Error & Cap & " + " & ".join(DS_SHORT[d] for d in sc.DATASETS) + r" & Mean \\", r"\midrule",
+        *out, r"\bottomrule", r"\end{tabular*}",
+        r"\par\smallskip\parbox{\textwidth}{\footnotesize A metric name in bold differs from the best metric "
+        r"at cap 4. n/s, no severity scale on that dataset; dash, error not injected. Abbreviations as in "
+        r"Table~\ref{tab:cap}; OV, overlap; BrCov80, branch coverage F1 (80\%).}",
+        r"\end{table*}", ""])
+
+
+# ----------------------------------------------------------------- Table L
