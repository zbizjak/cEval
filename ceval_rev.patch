+"""LaTeX tables for the robustness results of the revision.
+
+    CEVAL_TABLES_DIR=paper/tables_v5 python3 step5_robustness/make_tex.py
+
+Writes, from results/robustness/ and the sweep files:
+  tables_validation.tex  what each perturbation did (Table V)
+  tables_cap.tex         the selection at caps 4, 2 and 1 (Table C), and the
+                         best metric and score of every error on every
+                         dataset at the three caps (Table A.cap)
+  tables_holdout.tex     dataset and error-family holdouts at cap 4 (Table L)
+  tables_junction.tex    controlled junction displacement (Table J)
+"""
+import json
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from config import REPO, RESULTS, FIGURES, TABLES, DATA, VOLUME2GRAPH  # noqa: E402,F401
+
+import scoring as sc  # noqa: E402
+import selection as sel  # noqa: E402
+from scoring import mt  # noqa: E402
+
+ROB = RESULTS / "robustness"
+OUT = Path(os.environ.get("CEVAL_TABLES_DIR", TABLES))
+OUT.mkdir(parents=True, exist_ok=True)
+HEADER = "% Generated by step5_robustness/make_tex.py -- do not edit by hand.\n"
+
+SHORT = {"edge_F1": "Edge F1", "edge_R": "Edge R", "overlap_OV": "OV",
+         "branch_coverage_F1_80": "BrCov80", "branch_coverage_F1": "BrCov",
+         "netmets_geom_F1": "NetMets", "junction_F1": "Junc.", "endpoint_F1": "Endp.",
+         "netmets_conn_F1": "NetM.\\ conn.", "ASCD": "ASCD", "HD95": "HD95", "APLS": "APLS",
+         "beta0_err": r"$\beta_0$", "beta1_err": r"$\beta_1$", "branch_count_ratio": "BrCount",
+         "Len_tot": "Tot.\\ len.", "Len_br": "Br.\\ len.", "tortuosity": "Tort.", "Ang_bif": "Bif.\\ ang."}
+DS_SHORT = {"synthetic": "Synth.", "topcow_mr": "CoW MR", "topcow_ct": "CoW CT",
+            "aortaseg24": "Aorta", "imagecas": "CAS"}
+ERR_LONG = mt.ERROR_LONG
+names = lambda ms: ", ".join(SHORT.get(m, m) for m in ms)
+
+
+def fmt_int(n):
+    return f"{n:,}".replace(",", "{,}")
+
+
+# ----------------------------------------------------------------- Table V
+def validation_table():
+    v = json.loads((ROB / "perturbation_validation.json").read_text())
+    tot = lambda e, k: sum(d[e][k] for d in v.values() if e in d and d[e].get(k) is not None)
+    rows = []
+    for e, _ in mt.ERRORS:
+        n = tot(e, "rows")
+        fewer = tot(e, "fewer_than_requested")
+        if e == "disconnection":
+            ok = sum(d[e]["d_b0_equals_n_applied"] * d[e]["rows"] for d in v.values())
+            cuts, opened = tot(e, "cuts_total"), tot(e, "cuts_opening_a_cycle")
+            syn = v["synthetic"][e]
+            check = (rf"$\Delta\beta_0 = n$ in {100 * ok / n:.0f}\% of rows; {fmt_int(opened)} of "
+                     rf"{fmt_int(cuts)} cuts open a cycle instead ($\Delta\beta_1 = -1$), "
+                     rf"{syn['cuts_opening_a_cycle']} of {syn['cuts_total']} on the synthetic set")
+        elif e in ("false_component",):
+            check = r"$\Delta\beta_0 = n$ in every row"
+        elif e == "false_loop":
+            check = r"$\Delta\beta_1 = n$ in every row"
+        elif e == "cycle_disconnection":
+            check = r"$\Delta\beta_1 = -n$, $\Delta\beta_0 = 0$ in every row (each cut verified)"
+        elif e == "bifurcation_shift":
+            disp = [x for d in v.values() if e in d for x in d[e]["displacement_per_shift_mm"]]
+            check = (rf"$\Delta\beta = 0$; {tot(e, 'landmarks_moved')} other landmarks moved, "
+                     rf"{tot(e, 'new_coincident_pairs')} coincident nodes; {tot(e, 'rejected_operations')} "
+                     rf"operations rejected; arc within \SI{{1e-6}}{{\milli\metre}} of the request; "
+                     rf"displacement {min(disp):.1f}--{max(disp):.1f}\,mm per \SI{{3}}{{\milli\metre}} of arc")
+        else:
+            check = r"$\Delta\beta = 0$ in every row"
+        rows.append(rf"{ERR_LONG[e]} & {fmt_int(n)} & {fmt_int(fewer) if mt_kind(e) == 'count' else '--'} & {check} \\")
+    return "\n".join([
+        r"\begin{table}[t]", r"\centering",
+        r"\caption{What each perturbation did, over all five datasets. A row is one case at one "
+        r"severity step; $n$ is the number of errors applied.}",
+        r"\label{tab:validation}", r"\scriptsize", r"\setlength{\tabcolsep}{3pt}",
+        r"\begin{tabularx}{\columnwidth}{@{}>{\raggedright\arraybackslash}p{0.2\columnwidth}rr"
+        r">{\raggedright\arraybackslash}X@{}}",
+        r"\toprule",
+        r"Error & Rows & $n <$ req. & Realised change \\", r"\midrule", *rows, r"\bottomrule",
+        r"\end{tabularx}",
+        r"\par\smallskip\parbox{\columnwidth}{\footnotesize $n <$ req., rows that realised fewer "
+        r"errors than the severity step requested (a case with too few eligible sites).}",
+        r"\end{table}", ""])
+
+
+def mt_kind(e):
+    from perturb import PERTURBATIONS
+    return PERTURBATIONS[e]["severity_kind"]
+
+
+# ----------------------------------------------------------------- Table S
+def severity_table():
+    """Severity steps and fixed sizes of every error, in mm and in units of
+    each dataset's tau."""
+    from datasets import d_mm
+    taus = [0.7] + [d_mm(d) for d in sc.DATASETS[1:]]
+    count = r"1, 2, 3, 4, 6, 8"
+    rows = [  # error, steps, fixed size (mm, None for none), description of the size
+        ("disconnection", count, 2.0, "gap"),
+        ("false_component", count, 5.0, r"fragment ($\pm 25\%$)"),
+        ("false_loop", count, 6.0, r"span (bulge \SI{1.5}{\milli\metre})"),
+        ("cycle_disconnection", count, 1.0, "gap"),
+        ("missing_branch", count, None, "whole terminal branch"),
+        ("false_branch", count, 5.0, "branch"),
+        ("bifurcation_shift", count, 3.0, "arc along the host"),
+        ("spurious_bifurcation", count, 1.0, "stub"),
+        ("deformation", r"0.1--\SI{1.5}{\milli\metre}", 1.5, r"amplitude (wavelength \SI{20}{\milli\metre})"),
+        ("jitter", r"0.1--\SI{1.5}{\milli\metre}", 1.5, r"standard deviation per node"),
+    ]
+    out = []
+    for e, steps, size, what in rows:
+        if size is None:
+            cells = ["--"] * len(taus)
+            sz = ""
+        else:
+            cont = e in ("deformation", "jitter")
+            cells = [(f"{0.1 / t:.2f}--{size / t:.2f}" if cont else f"{size / t:.2f}") for t in taus]
+            sz = r"\SI{" + f"{size:g}" + r"}{\milli\metre}" if not cont else r"max.\ \SI{1.5}{\milli\metre}"
+        out.append(rf"{ERR_LONG[e]} & {steps} & {sz} {what} & " + " & ".join(cells) + r" \\")
+    return "\n".join([
+        r"\begin{table*}[t]", r"\centering",
+        r"\caption{Severity steps of every error, the fixed physical size of one counted error, and that size "
+        r"(for deformation and jitter the range of the six steps) in units of each dataset's tolerance $\tau$.}",
+        r"\label{tab:severity}", r"\scriptsize", r"\setlength{\tabcolsep}{4pt}",
+        r"\begin{tabular*}{\textwidth}{@{\extracolsep{\fill}}lll" + "c" * len(taus) + r"@{}}", r"\toprule",
+        r" & & & \multicolumn{" + str(len(taus)) + r"}{c}{Size in units of $\tau$} \\",
+        r"\cmidrule(l){4-" + str(3 + len(taus)) + r"}",
+        r"Error & Severity steps & Size of one error & "
+        + " & ".join(rf"{DS_SHORT[d]} ({t:g})" for d, t in zip(sc.DATASETS, taus)) + r" \\",
+        r"\midrule", *out, r"\bottomrule", r"\end{tabular*}",
+        r"\par\smallskip\parbox{\textwidth}{\footnotesize Steps of the counted errors are numbers of errors "
+        r"requested; the realised number can be lower (Table~\ref{tab:validation}). $\tau$ in mm in parentheses. "
+        r"A missing branch removes a whole terminal branch, shortest first, so its size varies.}",
+        r"\end{table*}", ""])
+
+
+# ----------------------------------------------------------------- Table C
+def cap_table():
+    s = json.loads((ROB / "selection.json").read_text())["settings"]
+    b = json.loads((ROB / "bootstrap" / "summary_n1000.json").read_text())["summary"]
+    lines = []
+    for pol, pol_label in (("analytical", "Circular pairs by definition (as in the text)"),
+                           ("cv", "Circular pairs by zero within-step variance")):
+      lines.append(rf"\multicolumn{{6}}{{@{{}}l}}{{\textit{{{pol_label}}}}} \\")
+      for cap in (4, 2, 1):
